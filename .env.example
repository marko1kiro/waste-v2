DATABASE_URL=postgresql://user:password@host/database?sslmode=require
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
BLOB_READ_WRITE_TOKEN=replace-with-vercel-blob-token
PUBLIC_URL=https://your-domain.example
API_KEY_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key

# Required to back up a PDF after its MIDNIGHT shift is marked done in daily_records.
# Create these for the Google Drive owner account using OAuth 2.0 refresh-token flow.
# Keep server-side only; never expose them through Vite/client environment variables.
GOOGLE_DRIVE_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
GOOGLE_DRIVE_CLIENT_SECRET=your-oauth-client-secret
GOOGLE_DRIVE_REFRESH_TOKEN=your-owner-account-refresh-token

# Required only when running npm run db:init
SEED_ADMIN_PASSWORD=replace-with-a-strong-password
SEED_STORE_PASSWORD=replace-with-a-different-strong-password
