# ============================================================
# AWAS v4 — Environment template
# Salin ke `.env` (jangan pernah commit file `.env`).
# SEMUA nilai di file ini adalah PLACEHOLDER — ganti dengan
# kredensial asli dari dashboard masing-masing layanan.
# ============================================================

# --- Database (Neon PostgreSQL) ---
DATABASE_URL=postgresql://user:changeme@localhost:5432/awas

# --- Auth ---
# Wajib >= 32 karakter acak
JWT_SECRET=replace-with-random-secret-min-32-chars-long
# Kunci 32-byte (base64) untuk enkripsi envelope API key
API_KEY_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key

# --- Storage foto: Vercel Blob (legacy) ---
BLOB_READ_WRITE_TOKEN=replace-with-vercel-blob-read-write-token
# URL publik aplikasi, dipakai untuk URL proxy
PUBLIC_URL=https://your-domain.example

# --- Cloudflare R2 (foto dokumentasi & backup PDF) ---
R2_ACCOUNT_ID=your-r2-account-id
R2_BUCKET=your-r2-bucket-name
R2_PUBLIC_DOMAIN=your-r2-public-domain.example
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key

# --- Google Drive: service account (backup PDF) ---
# Dipakai server/google-drive-neutral.ts untuk backup PDF resto via Google Drive
# (termasuk CKRBUL). Folder per-resto diambil dari kolom stores.drive_folder_id.
# Isi penuh JSON key service account, satu baris.
# Wajib server-side; JANGAN pernah di-expose via VITE_* / client.
GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"your-project-id","private_key_id":"your-key-id","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"your-sa@your-project.iam.gserviceaccount.com","client_id":"your-client-id"}

# --- Seed password (hanya untuk `npm run db:init`) ---
SEED_ADMIN_PASSWORD=replace-with-seed-admin-password-min-12-chars
SEED_STORE_PASSWORD=replace-with-seed-store-password-min-12-chars
